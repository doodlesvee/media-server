# Postgres connection used by the server (via Drizzle)
DATABASE_URL=postgres://media:media@localhost:5432/media

# Fastify server port
PORT=3000

# Root path(s) of the media library, mounted read-only into the container
MEDIA_ROOT=/media

# Writable directory for generated thumbnails/posters (holds thumbnails/ and posters/ subfolders)
APP_DATA_DIR=./app-data

# Which compose files a bare `docker compose` picks up. Without this, running
# `docker compose up -d` in docker/ uses the base file alone — which has no
# command for the development image, so the container exits immediately and
# restart-loops with no logs.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Where the browser thinks it is. Must match the address bar exactly or
# WebAuthn (Touch ID for discreet mode) is refused before the server sees it.
WEBAUTHN_ORIGIN=http://localhost:5173
